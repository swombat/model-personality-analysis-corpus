---
import BaseLayout from '../../layouts/BaseLayout.astro';
import models from '../../generated/models.json';
import { familyLabel } from '../../lib/modelMetadata.js';

export function getStaticPaths() {
  const families = [...new Set(models.filter((model) => model.status !== 'redirect').map((model) => model.family))].sort();
  return families.map((family) => ({ params: { family }, props: { family } }));
}

const { family } = Astro.props;
const displayFamily = familyLabel(family);
const familyModels = models
  .filter((model) => model.family === family && model.status !== 'redirect')
  .sort((a, b) => (b.release_date || '').localeCompare(a.release_date || '') || (a.display_name || a.model).localeCompare(b.display_name || b.model));
const base = import.meta.env.BASE_URL;

function releaseLabel(date) {
  if (!date) return 'Release date unavailable';
  return new Date(`${date}T00:00:00Z`).toLocaleDateString('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

function capabilityTitle(model) {
  const cap = model.capability;
  if (!cap) return '';
  if (cap.ladder === null || cap.ladder === undefined) {
    return 'Not yet scored on the capability ladder — no Epoch AI benchmark match for this model.';
  }
  return (
    `Capability ladder: ${cap.ladder} / ${cap.ladder_max} ` +
    `(measured ${cap.measured_rungs} of ${cap.n_rungs} rungs; ${cap.match_confidence} match to ${cap.epoch_model}). ` +
    `Source: Epoch AI Capabilities Index, CC BY 4.0.`
  );
}
---

<BaseLayout title={`${displayFamily} | Model Personality Browser`}>
  <h1>{displayFamily}</h1>
  <p class="lede">Models in the {displayFamily} family.</p>
  <section class="model-grid">
    {familyModels.map((model) => (
      <article class="model-card">
        {model.capability && (
          model.capability.ladder !== null && model.capability.ladder !== undefined ? (
            <a
              class="benchmark-score capability-score"
              href={`${base}methodology/capability-ladder/`}
              title={capabilityTitle(model)}
              aria-label={capabilityTitle(model)}
            >
              {model.capability.ladder}<span class="capability-score-max">/{model.capability.ladder_max}</span>
            </a>
          ) : (
            <a
              class="benchmark-score capability-score capability-score-unscored"
              href={`${base}methodology/capability-ladder/`}
              title={capabilityTitle(model)}
              aria-label={capabilityTitle(model)}
            >
              not scored
            </a>
          )
        )}
        <a class="card-link" href={`${base}models/${model.model}/`}>
          <div>
            <div class="card-kicker">
              <span class="chip">{model.lab}</span>
              <span class="chip green">{familyLabel(model.family)}</span>
            </div>
            <h2>{model.display_name || model.model}</h2>
            <p class="summary">{model.summary}</p>
            <p class="release-date">Released {releaseLabel(model.release_date)}</p>
          </div>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>
