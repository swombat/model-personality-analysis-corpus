---
import BaseLayout from '../../layouts/BaseLayout.astro';
import models from '../../generated/models.json';
import { familyLabel } from '../../lib/modelMetadata.js';

export function getStaticPaths() {
  const families = [...new Set(models.filter((model) => model.status !== 'redirect').map((model) => model.family))].sort();
  return families.map((family) => ({ params: { family }, props: { family } }));
}

const { family } = Astro.props;
const displayFamily = familyLabel(family);
const familyModels = models
  .filter((model) => model.family === family && model.status !== 'redirect')
  .sort((a, b) => (b.release_date || '').localeCompare(a.release_date || '') || (a.display_name || a.model).localeCompare(b.display_name || b.model));
const base = import.meta.env.BASE_URL;

function releaseLabel(date) {
  if (!date) return 'Release date unavailable';
  return new Date(`${date}T00:00:00Z`).toLocaleDateString('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

// Capability display has three tiers, never blended: a ladder score (Epoch
// AI), an Artificial Analysis Intelligence Index (AAII) fallback for models
// the ladder hasn't scored yet, or "not yet scored" when neither exists.
// See /methodology/capability-ladder/ ("Two sources, for now").
function capabilityDisplay(model) {
  const cap = model.capability;
  if (cap && cap.ladder !== null && cap.ladder !== undefined) {
    return { kind: 'ladder', cap };
  }
  const aaii = model.benchmarks?.aaii;
  if (aaii !== null && aaii !== undefined) {
    return { kind: 'aaii', aaii, indexVersion: model.benchmarks?.index_version || null };
  }
  return { kind: 'none' };
}

function capabilityTitle(display) {
  if (display.kind === 'ladder') {
    const cap = display.cap;
    return (
      `Capability ladder: ${cap.ladder} / ${cap.ladder_max} ` +
      `(measured ${cap.measured_rungs} of ${cap.n_rungs} rungs, median thinking budget; ` +
      `${cap.match_confidence} match to ${cap.matched_model}). ` +
      `Source: ${cap.source}.`
    );
  }
  if (display.kind === 'aaii') {
    return (
      `Artificial Analysis Intelligence Index: ${display.aaii}` +
      `${display.indexVersion ? ` (index version ${display.indexVersion})` : ''}. ` +
      `Shown as a fallback because this model has not yet been scored by the Epoch AI capability ladder; ` +
      `AAII versions are not comparable with each other or with the ladder.`
    );
  }
  return 'Not yet scored on the capability ladder, and no Artificial Analysis Intelligence Index on file for this model.';
}
---

<BaseLayout title={`${displayFamily} | Model Personality Browser`}>
  <h1>{displayFamily}</h1>
  <p class="lede">Models in the {displayFamily} family.</p>
  <section class="model-grid">
    {familyModels.map((model) => {
      const capabilityDisplayValue = capabilityDisplay(model);
      const capabilityTitleValue = capabilityTitle(capabilityDisplayValue);
      return (
      <article class="model-card">
        {capabilityDisplayValue.kind === 'ladder' && (
          <a
            class="benchmark-score capability-score"
            href={`${base}methodology/capability-ladder/`}
            title={capabilityTitleValue}
            aria-label={capabilityTitleValue}
          >
            {capabilityDisplayValue.cap.ladder}<span class="capability-score-max">/{capabilityDisplayValue.cap.ladder_max}</span>
          </a>
        )}
        {capabilityDisplayValue.kind === 'aaii' && (
          <a
            class="benchmark-score capability-score capability-score-aaii"
            href={`${base}methodology/capability-ladder/`}
            title={capabilityTitleValue}
            aria-label={capabilityTitleValue}
          >
            AAII {capabilityDisplayValue.aaii}
            {capabilityDisplayValue.indexVersion && (
              <span class="capability-score-version"> · v{capabilityDisplayValue.indexVersion}</span>
            )}
          </a>
        )}
        {capabilityDisplayValue.kind === 'none' && (
          <a
            class="benchmark-score capability-score capability-score-unscored"
            href={`${base}methodology/capability-ladder/`}
            title={capabilityTitleValue}
            aria-label={capabilityTitleValue}
          >
            not yet scored
          </a>
        )}
        <a class="card-link" href={`${base}models/${model.model}/`}>
          <div>
            <div class="card-kicker">
              <span class="chip">{model.lab}</span>
              <span class="chip green">{familyLabel(model.family)}</span>
            </div>
            <h2>{model.display_name || model.model}</h2>
            <p class="summary">{model.summary}</p>
            <p class="release-date">Released {releaseLabel(model.release_date)}</p>
          </div>
        </a>
      </article>
      );
    })}
  </section>
</BaseLayout>
