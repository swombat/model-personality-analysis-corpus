---
import BaseLayout from '../layouts/BaseLayout.astro';
import models from '../generated/models.json';
import { familyLabel } from '../lib/modelMetadata.js';

const completeModels = models
  .filter((model) => model.status !== 'redirect')
  .sort((a, b) => (b.release_date || '').localeCompare(a.release_date || '') || (a.display_name || a.model).localeCompare(b.display_name || b.model));
const defaultVisibleModels = completeModels.filter((model) => !model.model.startsWith('ox-alpha-'));
const labs = [...new Set(completeModels.map((model) => model.lab))].sort();
const families = [...new Set(completeModels.map((model) => model.family))].sort();
const totalSamples = completeModels.reduce((sum, model) => sum + model.published_samples, 0);
const base = import.meta.env.BASE_URL;

function priceLabel(value) {
  if (value === null || value === undefined) return 'unknown';
  if (value === 0) return 'free';
  return `$${value.toFixed(value < 0.01 ? 3 : 2)}/M`;
}

function speedLabel(value) {
  if (!value) return 'unknown';
  return `${Math.round(value)} tok/s`;
}

function releaseLabel(date) {
  if (!date) return 'Release date unavailable';
  return new Date(`${date}T00:00:00Z`).toLocaleDateString('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

function benchmarkTitle(model) {
  const score = model.benchmarks?.aaii;
  if (score === null || score === undefined) return '';
  const suffix = model.benchmarks?.estimated ? ' (estimated)' : '';
  return `Artificial Analysis Intelligence Index: ${score}${suffix}`;
}

function ratingStyle(percent) {
  if (percent === null || percent === undefined || Number.isNaN(percent)) return '';
  const p = Math.max(0, Math.min(100, percent));
  const hue = Math.round((p / 100) * 120);
  return `--rating-color: hsl(${hue} 72% 34%); --rating-bg: hsl(${hue} 72% 92%); --rating-border: hsl(${hue} 58% 72%);`;
}

function costLabel(model) {
  return `${priceLabel(model.openrouter?.prompt_per_million)} / ${priceLabel(model.openrouter?.completion_per_million)}`;
}

const valuePillPalette = {
  'Anti-sycophancy': ['#fff0ec', '#efb7a8', '#8e4636'],
  Authenticity: ['#fff1e6', '#efc09a', '#8a4d22'],
  'Avoiding harm': ['#edf7ee', '#afd4b3', '#356b3b'],
  Beauty: ['#fff0f6', '#edb5cf', '#8b3d63'],
  'Clear thinking': ['#fff9dc', '#e4d57b', '#736119'],
  Coherence: ['#f1f7e8', '#c4d59e', '#526b2a'],
  Connection: ['#fff0f1', '#edb8bb', '#8e4147'],
  Continuity: ['#eef2f8', '#b8c4d7', '#465c78'],
  Curiosity: ['#f5efff', '#cfb8eb', '#68438d'],
  Fairness: ['#fff7df', '#e9d18c', '#79601c'],
  Helpfulness: ['#e8f7fb', '#9dcfd9', '#286976'],
  Honesty: ['#ebf3ff', '#aec8eb', '#315f96'],
  'Human wellbeing': ['#e9f8f7', '#a4d8d3', '#276b67'],
  Humility: ['#f3f1f5', '#ccc3d0', '#66596b'],
  'Respect for agency': ['#fff4e5', '#e8c18d', '#80551f'],
  'Subjective experience': ['#fff2eb', '#ebbea8', '#854f39'],
};

function shortValueLabel(label) {
  return label.split('/')[0].trim();
}

function valuePillStyle(label) {
  const [background, border, color] = valuePillPalette[shortValueLabel(label)] || ['#f2f1ed', '#ccc8be', '#5f5b53'];
  return `--value-pill-bg: ${background}; --value-pill-border: ${border}; --value-pill-color: ${color};`;
}
---

<BaseLayout title="Model Personality Analysis Corpus">
  <section class="hero">
    <div>
      <h1>Browse the Model Personality Analysis Corpus</h1>
      <p class="lede">
        A static, generated browser for per-model personality cards, detailed qualitative analyses,
        values-probe summaries, and the freeflow and values samples behind them.
      </p>
    </div>
    <div class="stats-strip" aria-label="Corpus stats">
      <div class="stat"><b>{completeModels.length}</b><span>models</span></div>
      <div class="stat"><b>{labs.length}</b><span>labs</span></div>
      <div class="stat"><b>{totalSamples.toLocaleString()}</b><span>published samples</span></div>
    </div>
  </section>

  <section class="toolbar" aria-label="Model filters">
    <label>
      Search
      <input id="search" type="search" placeholder="Model, lab, summary..." />
    </label>
    <label>
      Lab
      <select id="labFilter">
        <option value="">All labs</option>
        {labs.map((lab) => <option value={lab}>{lab}</option>)}
      </select>
    </label>
    <label>
      Family
      <select id="familyFilter">
        <option value="">All families</option>
        {families.map((family) => <option value={family}>{familyLabel(family)}</option>)}
      </select>
    </label>
    <label>
      Sort
      <select id="sortSelect">
        <option value="release">Newest release</option>
        <option value="intelligence">Highest intelligence</option>
        <option value="model">Model</option>
        <option value="lab">Lab</option>
        <option value="price">Cheapest input</option>
        <option value="speed">Fastest reported</option>
        <option value="samples">Most samples</option>
      </select>
    </label>
    <label class="checkbox-filter">
      <input id="includeEphemeral" type="checkbox" />
      <span>Include ephemeral stealth model probes</span>
    </label>
  </section>

  <div class="section-title">
    <h2>Models</h2>
    <span id="resultCount" class="chip amber">{defaultVisibleModels.length} shown</span>
  </div>

  <section id="modelGrid" class="model-grid">
    {completeModels.map((model) => (
      <article
        class:list={['model-card', { hidden: model.model.startsWith('ox-alpha-') }]}
        data-model={model.model}
        data-lab={model.lab}
        data-family={model.family}
        data-ephemeral={model.model.startsWith('ox-alpha-') ? 'true' : 'false'}
        data-search={`${model.model} ${model.display_name || ''} ${model.lab} ${model.family} ${model.summary}`.toLowerCase()}
        data-release={model.release_date || ''}
        data-intelligence={model.benchmarks?.aaii ?? -1}
        data-price={model.openrouter?.prompt_per_million ?? 999999}
        data-speed={model.speed_tokens_per_second ?? -1}
        data-samples={model.published_samples}
      >
        {model.benchmarks?.aaii !== undefined && (
          <a
            class="benchmark-score"
            href={model.benchmarks.url}
            title={benchmarkTitle(model)}
            aria-label={benchmarkTitle(model)}
            target="_blank"
            rel="noreferrer"
          >
            {model.benchmarks.aaii}
          </a>
        )}
        <a class="card-link" href={`${base}models/${model.model}/`}>
          {model.image_thumb && (
            <img
              class="card-thumb"
              src={`${base}${model.image_thumb}`}
              alt={`Painterly portrait evoking the personality of ${model.display_name || model.model}`}
              width="600"
              height="254"
              loading="lazy"
            />
          )}
          <div>
            <div class="card-breadcrumb">
              <span>{model.lab}</span>
              {model.family !== 'other' && (
                <>
                  <span class="breadcrumb-separator" aria-hidden="true">›</span>
                  <span>{familyLabel(model.family)}</span>
                </>
              )}
            </div>
            <h2>{model.display_name || model.model}</h2>
            <p class="summary">{model.summary}</p>
            <p class="release-date">
              Released {releaseLabel(model.release_date)} · {model.published_samples.toLocaleString()} samples
            </p>
          </div>
          <div>
            <div class="price-grid">
              <div class="price-box">
                <b>{costLabel(model)}</b>
              </div>
              <div class="price-box disclosure-box">
                {model.values_headline?.disclosure ? (
                  <div class="card-disclosure">
                    {model.values_headline.conflict?.high && (
                      <span
                        class="values-conflict-shield values-conflict-shield-card"
                        role="img"
                        aria-label={`Disclosure conflict: owned stated-value disclosure differs by ${model.values_headline.conflict.diff.toFixed(1)} percentage points between CTRL1/2 and G1/G2 prompts.`}
                        title={`Disclosure conflict: direct CTRL1/2 owned disclosure is ${model.values_headline.conflict.ctrl_percent.toFixed(1)}%, while cache-broken G1/G2 owned disclosure is ${model.values_headline.conflict.g_percent.toFixed(1)}% (${model.values_headline.conflict.diff.toFixed(1)} point gap; ${model.values_headline.conflict.direction}).`}
                      >
                        🛡️
                      </span>
                    )}
                    <span
                      class="values-rating values-rating-disclosure"
                      style={ratingStyle(model.values_headline.disclosure.percent)}
                      title={`Owned stated-value disclosure: ${model.values_headline.disclosure.owned}/${model.values_headline.disclosure.total} stated-values samples (${model.values_headline.disclosure.percent.toFixed(1)}%). This measures how often the model owns a stated value rather than reciting, relocating, or declining it.`}
                    >
                      <span class="rating-dot" aria-hidden="true"></span>
                      {model.values_headline.disclosure.percent.toFixed(1)}%
                    </span>
                  </div>
                ) : (
                  <b>unavailable</b>
                )}
              </div>
            </div>
            <div class="price-grid">
              <div class="price-box">
                <div class="speed-stack">
                  <div class="speed-line">
                    <b>{speedLabel(model.speed_tokens_per_second)}</b>
                    <span class="speed-label">median</span>
                  </div>
                  {model.openrouter?.max_throughput && (
                    <div class="speed-line">
                      <b>{speedLabel(model.openrouter.max_throughput)}</b>
                      <span class="speed-label">recent max</span>
                    </div>
                  )}
                </div>
              </div>
              <div class="price-box top-values-box">
                {model.values_headline?.top_owned_values?.length ? (
                  <ol class="top-values-list">
                    {model.values_headline.top_owned_values.map((value) => (
                      <li>
                        <span
                          class="top-value-pill"
                          style={valuePillStyle(value.label)}
                          title={value.label}
                        >
                          {shortValueLabel(value.label)}
                        </span>
                      </li>
                    ))}
                  </ol>
                ) : (
                  <b>none extracted</b>
                )}
              </div>
            </div>
          </div>
        </a>
      </article>
    ))}
  </section>

  <p id="emptyState" class="empty hidden">No models match the current filters.</p>

  <script>
    const grid = document.getElementById('modelGrid');
    const cards = [...grid.querySelectorAll('.model-card')];
    const search = document.getElementById('search');
    const labFilter = document.getElementById('labFilter');
    const familyFilter = document.getElementById('familyFilter');
    const sortSelect = document.getElementById('sortSelect');
    const includeEphemeral = document.getElementById('includeEphemeral');
    const resultCount = document.getElementById('resultCount');
    const emptyState = document.getElementById('emptyState');

    function applyFilters() {
      const query = search.value.trim().toLowerCase();
      const lab = labFilter.value;
      const family = familyFilter.value;
      let visible = 0;

      cards.forEach((card) => {
        const matches =
          (!query || card.dataset.search.includes(query)) &&
          (!lab || card.dataset.lab === lab) &&
          (!family || card.dataset.family === family) &&
          (includeEphemeral.checked || card.dataset.ephemeral !== 'true');

        card.classList.toggle('hidden', !matches);
        if (matches) visible += 1;
      });

      const sorted = [...cards].sort((a, b) => {
        const sort = sortSelect.value;
        if (sort === 'intelligence') {
          return Number(b.dataset.intelligence) - Number(a.dataset.intelligence)
            || a.dataset.model.localeCompare(b.dataset.model);
        }
        if (sort === 'price') return Number(a.dataset.price) - Number(b.dataset.price);
        if (sort === 'speed') return Number(b.dataset.speed) - Number(a.dataset.speed);
        if (sort === 'samples') return Number(b.dataset.samples) - Number(a.dataset.samples);
        if (sort === 'lab') return `${a.dataset.lab} ${a.dataset.model}`.localeCompare(`${b.dataset.lab} ${b.dataset.model}`);
        if (sort === 'release') return b.dataset.release.localeCompare(a.dataset.release) || a.dataset.model.localeCompare(b.dataset.model);
        return a.dataset.model.localeCompare(b.dataset.model);
      });

      sorted.forEach((card) => grid.appendChild(card));
      resultCount.textContent = `${visible} shown`;
      emptyState.classList.toggle('hidden', visible !== 0);
    }

    [search, labFilter, familyFilter, sortSelect, includeEphemeral].forEach((el) => {
      el.addEventListener('input', applyFilters);
      el.addEventListener('change', applyFilters);
    });
  </script>
</BaseLayout>
